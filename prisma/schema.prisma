generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
}

model Demanda {
  id                         Int                  @id @default(autoincrement())
  nombres                    String
  apPaterno                  String
  apMaterno                  String
  run                        String               @unique
  nacionalidad               String
  estadoCivil                String
  fechaNacimiento            DateTime
  correoElectronico          String               @unique
  nombreRazonSocial          String
  rutRazonSocial             String
  domicilioRazonSocial       String
  representanteLegal         String
  runRepresentanteLegal      String
  fechaInicioRelacionLaboral DateTime?
  naturalezaContrato         String
  funciones                  String
  lugar                      String
  jornada                    String
  otraJornada                String?
  registroAsistencia         Boolean
  remuneracion               Float?
  formaPago                  String
  liquidacionSueldo          Boolean
  cotizacionSalud            String
  cotizacionAfp              String
  cotizacionAfc              String
  vacaciones                 Float?
  fuero                      String
  fechaTerminoRelaLaboral    DateTime?
  motivoTermino              String
  tipoDespido                String
  despidoDisciplinario       String
  otroDespidoDisciplinario   String?
  anosServicios              Boolean
  mesAviso                   Boolean
  finiquito                  Boolean
  prestacionesAdeudadas      String[]
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  demandadoSolidario         DemandadoSolidario[]
  materias                  String[]
}

model DemandadoSolidario {
  id                Int     @id @default(autoincrement())
  nombreRazonSocial String
  rut               String  @unique
  domicilio         String
  demandaId         Int
  demanda           Demanda @relation(fields: [demandaId], references: [id])
}

model Documento {
  id        String @id @default(uuid())
  nombre    String
  contenido Bytes
  usuarioId String
  tamano   Int
}

model DemandaDocumento {
  id        String @id @default(uuid())
  nombre    String
  contenido Bytes
  demandaId Int
  tamano   Int
}
