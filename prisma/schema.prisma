generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
}

model Demanda {
  id                         Int                  @id @default(autoincrement())
  nombres                    String
  apPaterno                  String
  apMaterno                  String
  run                        String               
  nacionalidad               String
  estadoCivil                String
  fechaNacimiento            DateTime
  correoElectronico          String               
  domicilioParticular        String
  nombreRazonSocial          String
  rutRazonSocial             String
  domicilioRazonSocial       String
  fechaInicioRelacionLaboral DateTime?
  naturalezaContrato         String
  funciones                  String
  lugar                      String
  jornada                    String
  otraJornada                String?
  registroAsistencia         Boolean
  remuneracion               Decimal?             @db.Decimal(12, 2)
  formaPago                  String
  liquidacionSueldo          Boolean
  cotizacionSalud            String
  cotizacionAfp              String
  cotizacionAfc              String
  vacaciones                 Float?
  fuero                      String
  fechaTerminoRelaLaboral    DateTime?
  motivoTermino              String?
  tipoDespido                String?
  despidoDisciplinario       String?
  otroDespidoDisciplinario   String?
  anosServicios              Boolean?
  mesAviso                   Boolean?
  finiquito                  Boolean?
  prestacionesAdeudadas      String[]             @default([])
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  demandadoSolidario         DemandadoSolidario[]
  materias                   String[]             @default([])
}

model DemandadoSolidario {
  id                    Int     @id @default(autoincrement())
  nombreRazonSocial     String
  rut                   String  
  domicilio             String
  demandaId             Int
  representanteLegal    String
  runRepresentanteLegal String
  demanda               Demanda @relation(fields: [demandaId], references: [id], onDelete: Cascade)
}

model Documento {
  id        String @id @default(uuid())
  nombre    String
  contenido Bytes
  usuarioId String
  tamano    Int
}

model DemandaDocumento {
  id        String @id @default(uuid())
  nombre    String
  contenido Bytes
  demandaId Int
  tamano    Int
}
