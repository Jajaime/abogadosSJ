generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                   String              @id @default(uuid())
  email                String              @unique
  name                 String?
  passwordHash         String?
  roles                String[]           @default(["user"])
  createdAt            DateTime            @default(now())
  demandas             Demanda[]           @relation("UsuarioDemandas")
  demandaDocumentos    DemandaDocumento[]  @relation("UsuarioDemandaDocumentos")
  sessions             Session[]
}

model Session {
  id                String   @id @default(uuid())
  userId            String
  refreshTokenHash  String
  version           Int      @default(0)
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              Usuario  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Demanda {
  id                         Int                  @id @default(autoincrement())
  nombres                    String
  apPaterno                  String
  apMaterno                  String
  run                        String
  nacionalidad               String
  estadoCivil                String
  fechaNacimiento            DateTime
  correoElectronico          String
  domicilioParticular        String
  nombreRazonSocial          String
  rutRazonSocial             String
  domicilioRazonSocial       String
  representanteLegal         String?
  runRepresentanteLegal      String?
  fechaInicioRelacionLaboral DateTime?
  naturalezaContrato         String
  funciones                  String
  lugar                      String
  jornada                    String
  otraJornada                String?
  registroAsistencia         Boolean
  remuneracion               Decimal?             @db.Decimal(12, 2)
  formaPago                  String
  liquidacionSueldo          Boolean
  cotizacionSalud            String[]             @db.Text
  cotizacionAfp              String[]             @db.Text
  cotizacionAfc              String[]             @db.Text
  vacaciones                 Float?
  fuero                      String
  fechaTerminoRelaLaboral    DateTime?
  motivoTermino              String?
  tipoDespido                String?
  despidoDisciplinario       String?
  otroDespidoDisciplinario   String?
  anosServicios              Boolean?
  mesAviso                   Boolean?
  finiquito                  Boolean?
  prestacionesAdeudadas      String[]             @default([])
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  usuarioId                  String?
  usuario                    Usuario?            @relation("UsuarioDemandas", fields: [usuarioId], references: [id], onDelete: SetNull)
  demandadoSolidario         DemandadoSolidario[]
  documentos                 DemandaDocumento[]
  materias                   String[]             @default([])
}

model DemandadoSolidario {
  id                    Int      @id @default(autoincrement())
  nombreRazonSocial     String
  rut                   String
  domicilio             String
  demandaId             Int
  representanteLegal    String
  runRepresentanteLegal String
  demanda               Demanda  @relation(fields: [demandaId], references: [id], onDelete: Cascade)
}

model DemandaDocumento {
  id         String   @id @default(uuid())
  nombre     String
  contenido  Bytes
  demandaId  Int      @unique
  usuarioId  String
  tamano     Int
  demanda    Demanda @relation(fields: [demandaId], references: [id], onDelete: Cascade)
  usuario    Usuario @relation("UsuarioDemandaDocumentos", fields: [usuarioId], references: [id], onDelete: Cascade)
}

